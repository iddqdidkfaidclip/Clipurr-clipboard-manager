    "Blur unfocused rows.\nPaste via ⇧⌃⌘V is always blurred.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blur unfocused rows.\nPaste via ⇧⌃⌘V is always blurred."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在聚焦某行之前模糊历史预览"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenfocar vistas previas del historial hasta enfocar una fila"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طمس معاينات السجل حتى يتم التركيز على صف"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buramkan pratinjau riwayat hingga baris difokuskan"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfocar prévias do histórico até que uma linha seja focada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flouter les aperçus de l’historique jusqu’à ce qu’une ligne soit sélectionnée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行にフォーカスするまで履歴のプレビューをぼかす"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Размываць прэв’ю ў гісторыі, пакуль радок не ў фокусе"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размывать превью в истории, пока строка не в фокусе"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschauen im Verlauf unscharf, bis eine Zeile fokussiert ist"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행에 포커스가 갈 때까지 기록 미리보기 흐리게"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoca le anteprime nella cronologia finché una riga non è attiva"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir satır odaklanana kadar geçmiş önizlemelerini bulanıklaştır"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm mờ xem trước lịch sử cho đến khi một hàng được tập trung"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmywaj podglądy w historii, dopóki wiersz nie ma fokusu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervag voorbeelden in de geschiedenis tot een rij de focus heeft"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เบลอตัวอย่างในประวัติจนกว่าแถวจะได้รับโฟกัส"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在聚焦某列之前模糊記錄預覽"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंक्ति फ़ोकस होने तक इतिहास पूर्वावलोकन धुंधले रखें"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌نمایش‌های تاریخچه را تا فوکوس شدن یک ردیف تار کنید"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudda förhandsvisningar i historiken tills en rad är i fokus"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozostřit náhledy v historii, dokud není řádek aktivní"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estompează previzualizările din istoric până când un rând este focalizat"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előzmények előnézeteinek elhomályosítása, amíg egy sor nincs fókuszban"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θόλωμα προεπισκοπήσεων ιστορικού μέχρι να εστιαστεί μια γραμμή"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טשטוש תצוגות מקדימות בהיסטוריה עד שורה מקבלת מיקוד"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slør forhåndsvisninger i historikken, indtil en række er i fokus"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumenna historian esikatselut, kunnes rivi on kohdistettu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør forhåndsvisninger i historikken uskarpe til en rad er i fokus"
          }
        },
