        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todo el texto, las imágenes y las referencias a archivos guardados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة كل النصوص والصور ومراجع الملفات المحفوظة نهائيًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus secara permanen semua teks, gambar, dan referensi file yang tersimpan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove permanentemente todo o texto, as imagens e as referências a arquivos salvos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement tous les textes, images et références de fichiers enregistrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのテキスト、画像、ファイル参照がすべて完全に削除されます。"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта назаўжды выдаліць увесь захаваны тэкст, выявы і спасылкі на файлы."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит весь сохранённый текст, изображения и ссылки на файлы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle gespeicherten Texte, Bilder und Dateiverweise dauerhaft entfernt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 모든 텍스트, 이미지 및 파일 참조가 영구적으로 삭제됩니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove definitivamente tutto il testo, le immagini e i riferimenti ai file salvati."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kaydedilmiş tüm metin, görüntü ve dosya başvurularını kalıcı olarak kaldırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa vĩnh viễn mọi văn bản, hình ảnh và tham chiếu tệp đã lưu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trwale usuwa cały zapisany tekst, obrazy i odwołania do plików."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert permanent alle opgeslagen tekst, afbeeldingen en bestandsverwijzingen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบข้อความ รูปภาพ และการอ้างอิงไฟล์ที่บันทึกไว้ทั้งหมดอย่างถาวร"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久移除所有已儲存的文字、影像與檔案參照。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सभी सहेजे गए टेक्स्ट, चित्र और फ़ाइल संदर्भ स्थायी रूप से हटा देता है।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار همه متن‌ها، تصاویر و ارجاعات فایل ذخیره‌شده را برای همیشه حذف می‌کند."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar permanent bort all sparad text, bilder och filreferenser."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se trvale odstraní veškerý uložený text, obrázky a odkazy na soubory."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină permanent tot textul, imaginile și referințele la fișiere salvate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez véglegesen eltávolítja az összes mentett szöveget, képet és fájlhivatkozást."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αφαιρεί οριστικά όλο το αποθηκευμένο κείμενο, τις εικόνες και τις αναφορές αρχείων."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מסירה לצמיתות את כל הטקסט, התמונות והפניות לקבצים השמורים."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner permanent al gemt tekst, billeder og filreferencer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi kaiken tallennetun tekstin, kuvat ja tiedostoviittaukset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner permanent all lagret tekst, bilder og filreferanser."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memadam secara kekal semua teks, imej dan rujukan fail yang disimpan."
          }
        }
      }
