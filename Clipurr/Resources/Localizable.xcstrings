          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइटम चुनने के बाद अन्य ऐप्स में पेस्ट करने के लिए आवश्यक"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
