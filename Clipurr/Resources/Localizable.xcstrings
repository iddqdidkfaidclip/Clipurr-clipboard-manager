    "This permanently removes all saved text, images, and file references.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes all saved text, images, and file references."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除所有已保存的文本、图片和文件引用。"
