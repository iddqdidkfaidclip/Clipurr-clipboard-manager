    "Clipurr will restart to apply the new language.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipurr will restart to apply the new language."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出并重新打开 Clipurr 以应用新语言。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal y vuelve a abrir Clipurr para aplicar el nuevo idioma."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ Clipurr وأعد فتحه لتطبيق اللغة الجديدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dan buka lagi Clipurr untuk menerapkan bahasa baru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saia e abra o Clipurr novamente para aplicar o novo idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez et rouvrez Clipurr pour appliquer la nouvelle langue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語を適用するには、Clipurr を終了して開き直してください。"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыйце і зноў адкрыйце Clipurr, каб прымяніць новую мову."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте и снова откройте Clipurr, чтобы применить новый язык."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende Clipurr und öffne es erneut, um die neue Sprache zu übernehmen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 언어를 적용하려면 Clipurr를 종료했다가 다시 여세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci e riapri Clipurr per applicare la nuova lingua."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni dili uygulamak için Clipurr’dan çıkıp yeniden açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoát và mở lại Clipurr để áp dụng ngôn ngữ mới."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ i ponownie otwórz Clipurr, aby zastosować nowy język."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit Clipurr af en open het opnieuw om de nieuwe taal toe te passen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกแล้วเปิด Clipurr อีกครั้งเพื่อใช้ภาษาใหม่"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束並重新打開 Clipurr 以套用新語言。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई भाषा लागू करने के लिए Clipurr बंद करें और फिर खोलें।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اعمال زبان جدید از Clipurr خارج شوید و دوباره باز کنید."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsluta och öppna Clipurr igen för att tillämpa det nya språket."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončete a znovu otevřete Clipurr, aby se použil nový jazyk."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Închide și redeschide Clipurr pentru a aplica noua limbă."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lépjen ki, és nyissa meg újra a Clipurrt az új nyelv alkalmazásához."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλείστε και ανοίξτε ξανά το Clipurr για εφαρμογή της νέας γλώσσας."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צא ופתח מחדש את Clipurr כדי להחיל את השפה החדשה."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslut og åbn Clipurr igen for at anvende det nye sprog."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopeta ja avaa Clipurr uudelleen uuden kielen käyttöönottoa varten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutt og åpne Clipurr på nytt for å bruke det nye språket."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dan buka semula Clipurr untuk menggunakan bahasa baharu."
          }
        }
      }
    },
