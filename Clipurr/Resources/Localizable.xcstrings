            "value": "复制文本、图片或文件以在此查看。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia texto, una imagen o archivos para verlos aquí."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ نصًا أو صورة أو ملفات لعرضها هنا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin teks, gambar, atau file untuk melihatnya di sini."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie texto, uma imagem ou arquivos para vê-los aqui."
          }
