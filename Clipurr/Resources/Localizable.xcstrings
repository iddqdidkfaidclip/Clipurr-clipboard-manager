    "Required to paste into other apps after you pick an item": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required to paste into other apps after you pick an item"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在选择项目后粘贴到其他应用所需"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para pegar en otras apps tras elegir un elemento"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب للصق في تطبيقات أخرى بعد اختيار عنصر"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan untuk menempel ke app lain setelah Anda memilih item"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para colar em outros apps depois de escolher um item"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requis pour coller dans d’autres apps après avoir choisi un élément"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を選んだあとにほかのアプリへペーストするために必要"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрэбна для ўстаўкі ў іншыя праграмы пасля выбару элемента"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно для вставки в другие приложения после выбора элемента"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderlich zum Einfügen in andere Apps nach Auswahl eines Eintrags"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 고른 후 다른 앱에 붙여넣는 데 필요"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessario per incollare in altre app dopo aver scelto un elemento"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir öğe seçtikten sonra diğer uygulamalara yapıştırmak için gerekli"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần thiết để dán vào ứng dụng khác sau khi chọn một mục"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagane do wklejenia w innych aplikacjach po wybraniu elementu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist om in andere apps te plakken nadat je een item kiest"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นเพื่อวางในแอปอื่นหลังจากเลือกรายการ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
