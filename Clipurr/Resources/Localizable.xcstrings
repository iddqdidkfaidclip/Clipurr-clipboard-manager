    "Copy text or files to see them here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy text or files to see them here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制文本或文件以在此查看。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia texto o archivos para verlos aquí."
          }
        },
        "ar": {
