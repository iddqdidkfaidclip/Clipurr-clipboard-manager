    },
    "macOS may need approval in System Settings → General → Login Items. Allow Clipurr there, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS may need approval in System Settings → General → Login Items. Allow Clipurr there, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 可能需要在“系统设置 → 通用 → 登录项”中批准。请在那里允许 Clipurr，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS puede requerir aprobación en Ajustes del Sistema → General → Elementos de inicio. Permite Clipurr allí y vuelve a intentarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يحتاج macOS إلى موافقة في إعدادات النظام ← عام ← عناصر تسجيل الدخول. اسمح لـ Clipurr هناك ثم أعد المحاولة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS mungkin memerlukan persetujuan di Pengaturan Sistem → Umum → Item Login. Izinkan Clipurr di sana, lalu coba lagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pode precisar de aprovação em Ajustes do Sistema → Geral → Itens de Início. Permita o Clipurr lá e tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS peut exiger une approbation dans Réglages Système → Général → Éléments d’ouverture. Autorisez Clipurr, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS では「システム設定 → 一般 → ログイン項目」での承認が必要な場合があります。そこで Clipurr を許可してから、もう一度お試しください。"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS можа запатрабаваць дазвол у «Сістэмныя налады → Асноўныя → Аб’екты ўваходу». Дазвольце Clipurr там і паўтарыце спробу."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS может потребовать разрешение в «Системные настройки → Основные → Объекты входа». Разрешите Clipurr там и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS benötigt möglicherweise eine Freigabe unter Systemeinstellungen → Allgemein → Anmeldeobjekte. Erlaube Clipurr dort und versuche es erneut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 시스템 설정 → 일반 → 로그인 항목에서 승인이 필요할 수 있습니다. 거기에서 Clipurr를 허용한 다음 다시 시도하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS potrebbe richiedere l’approvazione in Impostazioni di Sistema → Generali → Elementi di login. Consenti Clipurr lì, poi riprova."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, Sistem Ayarları → Genel → Giriş Öğeleri’nde onay isteyebilir. Orada Clipurr’a izin verin, sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS có thể cần phê duyệt trong Cài đặt Hệ thống → Chung → Mục đăng nhập. Cho phép Clipurr ở đó, rồi thử lại."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS może wymagać zgody w Ustawieniach systemowych → Ogólne → Elementy logowania. Zezwól tam Clipurr, a następnie spróbuj ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS heeft mogelijk goedkeuring nodig in Systeeminstellingen → Algemeen → Inlogitems. Sta Clipurr daar toe en probeer het opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS อาจต้องอนุมัติใน การตั้งค่าระบบ → ทั่วไป → รายการเข้าสู่ระบบ อนุญาต Clipurr ที่นั่น แล้วลองอีกครั้ง"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 可能需要在「系統設定 → 一般 → 登入項目」中核准。請在該處允許 Clipurr，然後再試一次。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS को सिस्टम सेटिंग्ज़ → सामान्य → लॉगिन आइटम में अनुमोदन की आवश्यकता हो सकती है। वहाँ Clipurr को अनुमति दें, फिर पुनः प्रयास करें।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است macOS در تنظیمات سیستم → عمومی → موارد ورود نیاز به تأیید داشته باشد. آنجا به Clipurr اجازه دهید و دوباره امتحان کنید."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kan kräva godkännande i Systeminställningar → Allmänt → Inloggningsobjekt. Tillåt Clipurr där och försök igen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS může vyžadovat schválení v Nastavení systému → Obecné → Položky přihlášení. Povolte tam Clipurr a zkuste to znovu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS poate necesita aprobare în Setări sistem → General → Elemente de autentificare. Permite Clipurr acolo, apoi încearcă din nou."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS-nek jóváhagyásra lehet szüksége a Rendszerbeállítások → Általános → Bejelentkezési elemek alatt. Engedélyezze ott a Clipurrt, majd próbálja újra."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS μπορεί να χρειάζεται έγκριση στις Ρυθμίσεις συστήματος → Γενικά → Στοιχεία σύνδεσης. Επιτρέψτε το Clipurr εκεί και δοκιμάστε ξανά."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן ש-macOS ידרוש אישור ב'הגדרות המערכת ← כללי ← פריטי כניסה'. אפשר שם את Clipurr ונסה שוב."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kan kræve godkendelse i Systemindstillinger → Generelt → Loginobjekter. Tillad Clipurr dér, og prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS saattaa tarvita hyväksynnän kohdassa Järjestelmäasetukset → Yleiset → Kirjautumiskohteet. Salli Clipurr siellä ja yritä uudelleen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kan trenge godkjenning i Systeminnstillinger → Generelt → Påloggingsobjekter. Tillat Clipurr der, og prøv igjen."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS mungkin memerlukan kelulusan dalam Tetapan Sistem → Umum → Item Log Masuk. Benarkan Clipurr di situ, kemudian cuba lagi."
          }
        }
      }
    },
