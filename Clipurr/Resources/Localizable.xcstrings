          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이미 사용 중이거나 등록할 수 없습니다(오류 %lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già in uso o non può essere registrato (errore %lld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zaten kullanımda veya kaydedilemedi (hata %lld)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã được dùng hoặc không thể đăng ký (lỗi %lld)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest już używany lub nie można go zarejestrować (błąd %lld)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is al in gebruik of kon niet worden geregistreerd (fout %lld)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ถูกใช้งานอยู่แล้วหรือลงทะเบียนไม่ได้ (ข้อผิดพลาด %lld)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被占用或無法註冊（錯誤 %lld）。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पहले से उपयोग में है या पंजीकृत नहीं हो सका (त्रुटि %lld)।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ در حال استفاده است یا ثبت نشد (خطای %lld)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ används redan eller kunde inte registreras (fel %lld)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se již používá nebo jej nelze zaregistrovat (chyba %lld)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este deja folosit sau nu a putut fi înregistrat (eroare %lld)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ már használatban van, vagy nem sikerült regisztrálni (hiba: %lld)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ χρησιμοποιείται ήδη ή δεν ήταν δυνατή η καταχώρισή του (σφάλμα %lld)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ כבר בשימוש או לא ניתן לרשום אותו (שגיאה %lld)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er allerede i brug eller kunne ikke registreres (fejl %lld)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on jo käytössä tai sitä ei voitu rekisteröidä (virhe %lld)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er allerede i bruk eller kunne ikke registreres (feil %lld)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sudah digunakan atau tidak dapat didaftarkan (ralat %lld)."
          }
        }
      }
    },
    "First local clipboard history for macOS with shoulder-surfing protection.\nClip → Purr → Paste": {
